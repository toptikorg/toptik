    #toptik-header .tt-shop-shortcuts a{display:flex;align-items:center;min-height:44px;font-size:15px;text-decoration:none;font-weight:600}
    #toptik-header .tt-shop-shortcuts a:focus-visible{outline:2px solid #76502e;outline-offset:2px}

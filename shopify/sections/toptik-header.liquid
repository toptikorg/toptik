  <style>
    #toptik-header .tt-nav__sale {
      color: #b65b2b;
      font-weight: 700;
    }
    #toptik-header .tt-nav__brands {
      position: relative;
      margin: 0;
      color: inherit;
    }
    #toptik-header .tt-nav__brands summary {
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      list-style: none;
      color: inherit;
      font: inherit;
      white-space: nowrap;
    }
    #toptik-header .tt-nav__brands summary::-webkit-details-marker {
      display: none;
    }
    #toptik-header .tt-nav__brands:not([open]) .tt-nav__submenu {
      display: none;
    }
    #toptik-header .tt-nav__brands[open] .tt-nav__submenu {
      display: grid;
    }
    #toptik-header .tt-nav__submenu {
      position: absolute;
      z-index: 60;
      top: calc(100% + 12px);
      right: 0;
      min-width: 190px;
      gap: 4px;
      padding: 10px;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 4px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
    }
    #toptik-header .tt-nav__submenu a {
      display: block;
      padding: 9px 12px;
      white-space: nowrap;
    }
    @media (max-width: 900px) {
      #toptik-header .tt-nav__brands {
        width: 100%;
      }
      #toptik-header .tt-nav__brands summary {
        justify-content: center;
      }
      #toptik-header .tt-nav__submenu {
        position: static;
        min-width: 0;
        margin-top: 6px;
        padding: 4px 0 0;
        background: transparent;
        border: 0;
        box-shadow: none;
        text-align: center;
      }
    }
  </style>
  <script>
    (function () {
      var header = document.getElementById('toptik-header');
      if (!header) return;
      var button = header.querySelector('.tt-burger');
      var nav = header.querySelector('#tt-main-nav');
      if (!button || !nav) return;

      function setMenu(open) {
        nav.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.setAttribute('aria-label', open ? 'סגירת תפריט' : 'פתיחת תפריט');
      }

      button.addEventListener('click', function () {
        setMenu(button.getAttribute('aria-expanded') !== 'true');
      });
      nav.addEventListener('click', function (event) {
        if (event.target.closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          button.focus();
        }
      });
    }());
  </script>
